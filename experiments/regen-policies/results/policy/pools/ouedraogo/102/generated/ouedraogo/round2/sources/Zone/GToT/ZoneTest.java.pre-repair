    @Test
    public void testConstructorNullNameThrows() throws IOException {
        thrown.expect(IllegalArgumentException.class);
        thrown.expectMessage("no zone name specified");
        new Zone(null, new ByteArrayInputStream(new byte[0]));
    }

    @Test
    public void testConstructorNullInputStreamThrows() throws IOException {
        thrown.expect(IllegalArgumentException.class);
        thrown.expectMessage("no input stream specified");
        new Zone(origin, (InputStream) null);
    }

    @Test
    public void testConstructorMissingSOAThrows() throws IOException {
        // Build a zone without SOA – validation should fail
        Record[] records = new Record[]{ns1, ns2};
        thrown.expect(IOException.class);
        thrown.expectMessage("exactly 1 SOA must be specified");
        new Zone(origin, records);
    }

    @Test
    public void testConstructorMissingNSThrows() throws IOException {
        // Build a zone with SOA but no NS
        Record[] records = new Record[]{soa};
        thrown.expect(IOException.class);
        thrown.expectMessage("no NS set specified");
        new Zone(origin, records);
    }

    @Test
    public void testAddRecordNullThrows() {
