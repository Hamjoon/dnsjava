    @Test
    public void testIteratorRemoveWithoutNextThrows() {
        Iterator<RRset> it = zone.iterator();
        thrown.expect(IllegalStateException.class);
        it.remove(); // remove called before next()
    }

    @Test
    public void testZoneIteratorRemoveSOAThrows() {
        Iterator<RRset> it = zone.iterator();
        // first element is SOA
        RRset first = it.next();
        assertEquals(Type.SOA, first.getType());

        thrown.expect(IllegalArgumentException.class);
        it.remove(); // attempt to remove the SOA via the iterator
    }

    @Test
    public void testZoneIteratorRemoveNSAllowed() {
        Iterator<RRset> it = zone.iterator();
        // skip SOA
        it.next();
        // second element is NS
        RRset nsSet = it.next();
        assertEquals(Type.NS, nsSet.getType());

        // Removing NS via iterator is allowed only if more than one NS remains.
        // Our zone has two NS records, so removal should succeed.
        it.remove();

        // After removal, the NS set should be gone from the zone
        assertNull(zone.getNS());
    }

