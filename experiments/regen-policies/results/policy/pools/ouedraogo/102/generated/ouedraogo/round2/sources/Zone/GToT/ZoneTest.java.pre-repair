        zone.addRecord(null);
    }

    @Test
    public void testAddRecordSOAWithWrongOwnerThrows() throws IOException {
        // SOA whose owner is not the zone origin
        SOARecord badSoa = new SOARecord(
                Name.fromString("bad.example.com."),
                DClass.IN,
                3600,
                Name.fromString("ns1.example.com."),
                Name.fromString("hostmaster.example.com."),
                2023101502L,
                7200, 3600, 1209600, 3600);
        thrown.expect(IllegalArgumentException.class);
        thrown.expectMessage("SOA owner");
        zone.addRecord(badSoa);
    }

    @Test
