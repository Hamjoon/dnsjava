public class ZoneTest {

    /* ---------------------------------------------------------------------- */
    /*  Helper data used by many tests                                        */
    /* ---------------------------------------------------------------------- */

    private Name origin;
    private SOARecord soa;
    private NSRecord ns1;
    private NSRecord ns2;
    private ARecord aRecord;          // simple A record for lookup tests
    private Zone zone;                 // zone created from the record array ctor

    @Rule
    public ExpectedException thrown = ExpectedException.none();

    /**
     * Build a minimal but fully‑valid zone containing:
     *   – exactly one SOA record (origin)
     *   – two NS records (origin)
     *   – one A record (foo.origin)
     */
    @Before
    public void setUp() throws Exception {
        origin = Name.fromString("example.com.");

        // SOA (origin)
        soa = new SOARecord(
                origin,
                DClass.IN,
                3600,
                Name.fromString("ns1.example.com."),
                Name.fromString("hostmaster.example.com."),
                2023101501L,   // serial
                7200,          // refresh
                3600,          // retry
                1209600,       // expire
                3600);         // minimum

        // two NS records at the zone apex
        ns1 = new NSRecord(origin, DClass.IN, 3600,
                Name.fromString("ns1.example.com."));
        ns2 = new NSRecord(origin, DClass.IN, 3600,
                Name.fromString("ns2.example.com."));

        // an A record for a child name
        aRecord = new ARecord(
                Name.fromString("www.example.com."),
                DClass.IN,
                3600,
                InetAddress.getByName("192.0.2.1"));

        // Build the zone via the var‑args constructor (the most direct way)
        zone = new Zone(origin, soa, ns1, ns2, aRecord);
    }

    /* ---------------------------------------------------------------------- */
    /*  1. Public method signatures (for reference)                           */
    /* ---------------------------------------------------------------------- */
