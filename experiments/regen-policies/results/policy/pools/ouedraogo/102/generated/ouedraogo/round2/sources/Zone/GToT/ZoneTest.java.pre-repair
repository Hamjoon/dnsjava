    @Test
    public void testAddRRsetInvalidSOATypeThrows() throws IOException {
        // Build an RRset that contains two SOA records – violates the rule of exactly one
        RRset badSet = new RRset(soa, new SOARecord(
                origin,
                DClass.IN,
                3600,
                Name.fromString("ns1.example.com."),
                Name.fromString("hostmaster.example.com."),
                2023101503L,
                7200, 3600, 1209600, 3600));
        thrown.expect(IllegalArgumentException.class);
        thrown.expectMessage("exactly 1 SOA must be specified");
        zone.addRRset(badSet);
    }

