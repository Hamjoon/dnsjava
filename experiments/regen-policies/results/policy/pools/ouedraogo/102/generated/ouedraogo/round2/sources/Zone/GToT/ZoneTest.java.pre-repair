    /*  2. Basic functionality tests                                           */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testGetDClass() {
        assertEquals(DClass.IN, zone.getDClass());
    }

    @Test
    public void testGetSOA() {
        assertSame(soa, zone.getSOA());
    }

    @Test
    public void testGetNS() {
        RRset nsSet = zone.getNS();
        assertNotNull(nsSet);
        assertEquals(Type.NS, nsSet.getType());
        // the set should contain exactly the two NS records we added
        List<Record> records = nsSet.rrs();
        assertEquals(2, records.size());
        assertTrue(records.contains(ns1));
        assertTrue(records.contains(ns2));
    }

    @Test
    public void testIteratorOrder() {
        Iterator<RRset> it = zone.iterator();
        // First set must be the SOA, second the NS set
        assertTrue(it.hasNext());
        RRset first = it.next();
        assertEquals(Type.SOA, first.getType());

        assertTrue(it.hasNext());
        RRset second = it.next();
        assertEquals(Type.NS, second.getType());

        // The remaining sets include the A record
        assertTrue(it.hasNext());
        RRset third = it.next();
        assertEquals(Type.A, third.getType());

        assertFalse(it.hasNext());
    }

    @Test
    public void testAXFRIncludesTrailingSOA() {
        Iterator<RRset> axfr = zone.AXFR();
        // Consume all normal entries
        while (axfr.hasNext()) {
            RRset set = axfr.next();
            // nothing to assert inside the loop – just iterate
        }
        // After the normal iteration the iterator should still have one more SOA
        // (the trailing one). The previous loop ends when hasNext() becomes false,
        // so we need a fresh iterator to verify the trailing SOA.
        Iterator<RRset> fresh = zone.AXFR();
        int count = 0;
        RRset last = null;
        while (fresh.hasNext()) {
            last = fresh.next();
            count++;
        }
        // The last set must be the SOA again
        assertNotNull(last);
        assertEquals(Type.SOA, last.getType());
        // Total count = (normal sets) + 1 trailing SOA
        // Normal sets: SOA, NS, A  => 3, plus trailing SOA => 4
        assertEquals(4, count);
    }

    @Test
    public void testAddRecordAddsNewRRset() throws IOException {
        // Add a TXT record that does not yet exist in the zone
        TXTRecord txt = new TXTRecord(
                Name.fromString("txt.example.com."),
                DClass.IN,
                3600,
                "hello");
        zone.addRecord(txt);

        RRset found = zone.findExactMatch(txt.getName(), Type.TXT);
        assertNotNull(found);
        assertEquals(1, found.size());
        assertEquals(txt, found.first());
    }

    @Test
    public void testAddRecordMergesIntoExistingRRset() throws IOException {
        // Add a second A record for the same name
        ARecord a2 = new ARecord(
                aRecord.getName(),
                DClass.IN,
                3600,
                InetAddress.getByName("192.0.2.2"));
        zone.addRecord(a2);

        RRset aSet = zone.findExactMatch(aRecord.getName(), Type.A);
        assertNotNull(aSet);
        assertEquals(2, aSet.size());
        assertTrue(aSet.rrs().contains(aRecord));
        assertTrue(aSet.rrs().contains(a2));
    }

    @Test
    public void testRemoveRecordRemovesOnlyOneRR() throws IOException {
        // Remove one of the NS records; the other must stay
        zone.removeRecord(ns1);
        RRset nsSet = zone.getNS();
        assertEquals(1, nsSet.size());
        assertTrue(nsSet.rrs().contains(ns2));
    }

    @Test
    public void testRemoveRecordLastNSThrows() throws IOException {
        // Remove both NS records – the second removal must fail
        zone.removeRecord(ns1);
        thrown.expect(IllegalArgumentException.class);
        thrown.expectMessage("Cannot remove all NS");
        zone.removeRecord(ns2);
    }

    @Test
    public void testAddRRsetReplacesExisting() throws IOException {
        // Build a new NS RRset (different target) and add it – should replace
        NSRecord nsNew = new NSRecord(
                origin,
                DClass.IN,
                3600,
                Name.fromString("ns3.example.com."));
        RRset newNsSet = new RRset(nsNew);
        zone.addRRset(newNsSet);

        RRset stored = zone.getNS();
        assertEquals(1, stored.size());
        assertEquals(nsNew, stored.first());
    }

    @Test
    public void testRemoveRRsetRemovesSpecificType() throws IOException {
        // Remove the A record RRset via removeRRset
        zone.removeRRset(aRecord.getName(), Type.A);
        RRset aSet = zone.findExactMatch(aRecord.getName(), Type.A);
        assertNull(aSet);
    }

    @Test
    public void testFindExactMatch() {
        RRset result = zone.findExactMatch(ns1.getName(), Type.NS);
        assertNotNull(result);
        assertEquals(ns1.getName(), result.getName());
        assertEquals(Type.NS, result.getType());
    }

    @Test
    public void testFindExactMatchMissingReturnsNull() {
        Name unknown = Name.fromString("nosuch.example.com.");
        assertNull(zone.findExactMatch(unknown, Type.A));
    }

    @Test
    public void testFindRecordsExactMatchSuccess() {
        SetResponse resp = zone.findRecords(aRecord.getName(), Type.A);
        assertTrue(resp.isSuccessful());
        List<RRset> answers = resp.answers();
        assertEquals(1, answers.size());
        RRset aSet = answers.get(0);
        assertEquals(Type.A, aSet.getType());
        assertEquals(aRecord.getName(), aSet.getName());
    }

    @Test
    public void testFindRecordsCNAMEFallback() throws IOException {
        // Create a CNAME for foo.example.com -> www.example.com
        CNAMERecord cname = new CNAMERecord(
                Name.fromString("foo.example.com."),
                DClass.IN,
                3600,
                Name.fromString("www.example.com."));
        zone.addRecord(cname);

        SetResponse resp = zone.findRecords(cname.getName(), Type.A);
        assertTrue(resp.isCNAME());
        assertEquals(cname, resp.getCNAME());
    }

    @Test
    public void testFindRecordsNXDOMAIN() {
        Name outside = Name.fromString("outside.com.");
        SetResponse resp = zone.findRecords(outside, Type.A);
        assertTrue(resp.isNXDOMAIN());
    }

    @Test
    public void testToMasterFileContainsAllRecords() {
        String master = zone.toMasterFile();
        // Very light validation – ensure that the SOA, NS and A appear as text
        assertTrue(master.contains("example.com."));
        assertTrue(master.contains("ns1.example.com."));
        assertTrue(master.contains("www.example.com."));
    }

    @Test
    public void testToStringDelegatesToMasterFile() {
        assertEquals(zone.toMasterFile(), zone.toString());
    }

