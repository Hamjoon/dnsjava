[
  {
    "group": "Valid scenarios - section empty",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.com.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": false,
        "description": "The requested section exists but is null (no records). The method should return false without iterating."
      }
    ]
  },
  {
    "group": "Valid scenarios - no matching record",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.org.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": false,
        "description": "Section contains records, but none match both the supplied name and type. The method should iterate all records and finally return false."
      }
    ]
  },
  {
    "group": "Valid scenarios - matching record found",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.net.\")"
          },
          {
            "parameter": "type",
            "value": "Type.AAAA"
          },
          {
            "parameter": "section",
            "value": "Section.AUTHORITY"
          }
        ],
        "expected": true,
        "description": "Section contains at least one record whose name and type exactly match the arguments. The method should return true as soon as the first match is found."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.net.\")"
          },
          {
            "parameter": "type",
            "value": "Type.AAAA"
          },
          {
            "parameter": "section",
            "value": "Section.AUTHORITY"
          }
        ],
        "expected": true,
        "description": "Multiple records exist; the matching record is not the first element. The loop must continue until it finds the match and then return true."
      }
    ]
  },
  {
    "group": "Invalid inputs - type validation failure",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.com.\")"
          },
          {
            "parameter": "type",
            "value": "-1"
          },
          {
            "parameter": "section",
            "value": "Section.QUESTION"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Type.check throws IllegalArgumentException for an invalid type value. The method should not proceed to section handling."
      }
    ]
  },
  {
    "group": "Invalid inputs - section validation failure",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.com.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "10",
            "note": "value outside the valid Section range (0\u20113)"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "Section.check throws IllegalArgumentException for an out\u2011of\u2011range section index. The method should abort before accessing the sections array."
      }
    ]
  },
  {
    "group": "Valid scenarios - empty list section",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.org.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ADDITIONAL"
          }
        ],
        "expected": false,
        "description": "The requested section exists and is an empty List (not null). The method should iterate zero times and return false."
      }
    ]
  },
  {
    "group": "Valid scenarios - match first record",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"first.example.\")"
          },
          {
            "parameter": "type",
            "value": "Type.MX"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": true,
        "description": "The first record in the section matches both name and type; the method should return true immediately without scanning the rest."
      }
    ]
  },
  {
    "group": "Valid scenarios - match last record",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"last.example.\")"
          },
          {
            "parameter": "type",
            "value": "Type.NS"
          },
          {
            "parameter": "section",
            "value": "Section.AUTHORITY"
          }
        ],
        "expected": true,
        "description": "Multiple records are present; only the last one matches the supplied name and type. The loop must scan all preceding records before returning true."
      }
    ]
  },
  {
    "group": "Valid scenarios - different type same name",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"mixed.example.\")"
          },
          {
            "parameter": "type",
            "value": "Type.SOA"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": false,
        "description": "The section contains records with the same name but different types. Because none have the requested type, the method should return false."
      }
    ]
  },
  {
    "group": "Valid scenarios - different name same type",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"nonexistent.example.\")"
          },
          {
            "parameter": "type",
            "value": "Type.TXT"
          },
          {
            "parameter": "section",
            "value": "Section.ADDITIONAL"
          }
        ],
        "expected": false,
        "description": "Records of the requested type exist in the section, but none have the supplied name. The method must return false after full iteration."
      }
    ]
  },
  {
    "group": "Invalid inputs - null name",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "null"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.QUESTION"
          }
        ],
        "expected": "NullPointerException",
        "description": "Passing a null Name causes a NullPointerException when name.equals(...) is invoked. The method does not guard against null, so the exception is expected."
      }
    ]
  },
  {
    "group": "Exception scenarios - null sections array",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.com.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "NullPointerException",
        "description": "The Message instance has its internal `sections` array set to null before invoking findRRset. Accessing sections[section] triggers a NullPointerException."
      }
    ]
  },
  {
    "group": "Exception scenarios - null record in section list",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.org.\")"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.AUTHORITY"
          }
        ],
        "expected": "NullPointerException",
        "description": "The requested section list is non\u2011null but contains a null element. When the loop reaches this element, calling r.getType() causes a NullPointerException."
      }
    ]
  },
  {
    "group": "Exception scenarios - sections array shorter than expected",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name.fromString(\"example.net.\")"
          },
          {
            "parameter": "type",
            "value": "Type.AAAA"
          },
          {
            "parameter": "section",
            "value": "Section.ADDITIONAL"
          }
        ],
        "expected": "ArrayIndexOutOfBoundsException",
        "description": "The Message instance is constructed with a `sections` array of length 2. Calling findRRset with a valid section index (e.g., Section.ADDITIONAL == 3) bypasses Section.check but attempts to access sections[3], resulting in ArrayIndexOutOfBoundsException."
      }
    ]
  }
]