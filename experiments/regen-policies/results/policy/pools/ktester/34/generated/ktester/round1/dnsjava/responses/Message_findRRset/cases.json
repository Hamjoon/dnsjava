[
  {
    "group": "Valid scenarios",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": false,
        "description": "The requested section (ANSWER) is null in the Message, therefore findRRset returns false."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.org.')"
          },
          {
            "parameter": "type",
            "value": "Type.AAAA"
          },
          {
            "parameter": "section",
            "value": "Section.AUTHORITY"
          }
        ],
        "expected": false,
        "description": "Section AUTHORITY exists but is an empty list; no RRset can be found, method returns false."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.net.')"
          },
          {
            "parameter": "type",
            "value": "Type.MX"
          },
          {
            "parameter": "section",
            "value": "Section.ADDITIONAL"
          }
        ],
        "expected": false,
        "description": "Section contains records, but none match the supplied name and type; method iterates through all and returns false."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": true,
        "description": "Section ANSWER holds a Record of type A with name 'example.com.'; the first matching RRset is found and method returns true."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.TXT"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": true,
        "description": "Section ANSWER contains several records; a matching TXT record appears after a few non\u2011matching ones. The loop should continue until the match is found and then return true."
      }
    ]
  },
  {
    "group": "Invalid inputs",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": -1
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The supplied type is not a valid DNS type; Type.check should throw IllegalArgumentException before any array access."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": -1
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The supplied section index is negative; Section.check should throw IllegalArgumentException."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "null"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "NullPointerException",
        "description": "Passing a null Name leads to a NullPointerException when name.equals(r.getName()) is evaluated."
      }
    ]
  },
  {
    "group": "Additional exception scenarios",
    "cases": [
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": 70000
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The supplied type exceeds the maximum DNS type value; Type.check should throw IllegalArgumentException before any array access."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": 10
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The supplied section index is larger than any defined DNS section; Section.check should throw IllegalArgumentException."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "NullPointerException",
        "description": "The internal `sections` array of the Message instance has been set to null (e.g., via reflection). Accessing `sections[section]` triggers a NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "NullPointerException",
        "description": "A Record with a null name is added to the specified section. When the method evaluates `name.equals(r.getName())`, a NullPointerException is thrown because `r.getName()` returns null."
      },
      {
        "input": [
          {
            "parameter": "name",
            "value": "Name('example.com.')"
          },
          {
            "parameter": "type",
            "value": "Type.A"
          },
          {
            "parameter": "section",
            "value": "Section.ANSWER"
          }
        ],
        "expected": "NullPointerException",
        "description": "The list for the given section contains a null element. The loop retrieves `null` as `r` and attempts to call `r.getType()`, resulting in a NullPointerException."
      }
    ]
  }
]