  },
  {
    "group": "Time\u2011signed (fudge) validation",
    "cases": [
      {
        "input": [
          {
            "parameter": "Message m",
            "value": "validMessage"
          },
          {
            "parameter": "byte[] b",
            "value": "validKeyBytes"
          },
          {
            "parameter": "int error",
            "value": "0"
          },
          {
            "parameter": "TSIGRecord old",
            "value": "null"
          }
        ],
        "expected": "TSIGRecord whose timeSigned is within \u00b1FUDGE (300\u202fs) of the system clock at generation time",
        "description": "The generated TSIGRecord must set the time\u2011signed field to the current instant; the test verifies that it lies inside the allowed fudge window."
      }
    ]
  },
  {
    "group": "Old TSIGRecord null fields",
    "cases": [
      {
        "input": [
          {
            "parameter": "Message m",
            "value": "validMessage"
          },
          {
            "parameter": "byte[] b",
            "value": "validKeyBytes"
          },
          {
            "parameter": "int error",
            "value": "0"
          },
          {
            "parameter": "TSIGRecord old",
            "value": "oldRecordWithNullSignature"
          }
        ],
        "expected": "NullPointerException",
        "description": "When the supplied old TSIGRecord has a null signature field, generate attempts to copy the previous MAC and throws NPE."
