  {
    "group": "Invalid key for MAC initialization",
    "cases": [
      {
        "input": [
          {
            "parameter": "Message m",
            "value": "validMessageSHA256"
          },
          {
            "parameter": "byte[] b",
            "value": "invalidKeyForSHA256"
          },
          {
            "parameter": "int error",
            "value": "0"
          },
          {
            "parameter": "TSIGRecord old",
            "value": "null"
          }
        ],
        "expected": "InvalidKeyException",
        "description": "Supplying a key that the underlying JCE provider deems invalid for the selected HMAC algorithm (e.g., a key with illegal length for a hardware\u2011bound provider) causes Mac.init() to throw InvalidKeyException, which propagates as a GeneralSecurityException."
      }
    ]
  }
]