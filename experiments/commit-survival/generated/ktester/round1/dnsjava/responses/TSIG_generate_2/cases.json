          {
            "parameter": "m",
            "value": "mockMessage"
          },
          {
            "parameter": "b",
            "value": "new byte[0]"
          },
          {
            "parameter": "error",
            "value": "Rcode.NOERROR"
          },
          {
            "parameter": "old",
            "value": "mockOldRecord"
          },
          {
            "parameter": "fullSignature",
            "value": "true"
          }
        ],
        "expected": "The private generate method receives fullSignature == true; the returned TSIGRecord is the stubbed true\u2011signature record.",
        "description": "Verify that the boolean fullSignature argument is forwarded unchanged to the internal generate method."
      },
      {
        "input": [
          {
            "parameter": "m",
            "value": "mockMessage"
          },
          {
            "parameter": "b",
            "value": "new byte[0]"
          },
          {
            "parameter": "error",
            "value": "Rcode.NOERROR"
          },
          {
            "parameter": "old",
            "value": "mockOldRecord"
          },
          {
            "parameter": "fullSignature",
            "value": "false"
          }
        ],
        "expected": "The private generate method receives fullSignature == false; the returned TSIGRecord is the stubbed false\u2011signature record.",
        "description": "Same as above but with fullSignature set to false."
      }
    ]
  },
  {
